generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum PetStatus {
  ACTIVE
  INACTIVE
  SOLD
  DECEASED
}

enum OwnershipType {
  PRIMARY
  CO_OWNER
  TEMPORARY
}

enum ListingType {
  DIRECT_SALE
  AUCTION
}

enum ListingStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SOLD
  CANCELLED
  EXPIRED
}

enum AuctionStatus {
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
  SETTLED
}

enum BidStatus {
  VALID
  OUTBID
  WINNING
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OwnershipTransferStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VaccinationStatus {
  UP_TO_DATE
  DUE_SOON
  OVERDUE
}

enum ReviewTargetType {
  SELLER
  PRODUCT
  SERVICE_PROVIDER
  SERVICE
}

enum NotificationType {
  AUCTION
  VACCINATION
  HOSPITALITY
  MARKETPLACE
  SYSTEM
}

// ─── Auth & Users ────────────────────────────────────────────────────────────

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  phone          String?    @unique
  passwordHash   String     @map("password_hash")
  profileImage   String?    @map("profile_image")
  status         UserStatus @default(ACTIVE)
  emailVerified  Boolean    @default(false) @map("email_verified")
  phoneVerified  Boolean    @default(false) @map("phone_verified")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  roles              UserRole[]
  addresses          Address[]
  pets               Pet[]              @relation("PetOwner")
  petOwnerships      PetOwner[]
  listings           PetListing[]       @relation("SellerListings")
  bids               Bid[]
  auctionWins        AuctionWinner[]
  products           Product[]
  orders             Order[]
  cart               Cart?
  serviceProvider    ServiceProvider?
  bookings           Booking[]          @relation("CustomerBookings")
  vaccinationsGiven  Vaccination[]      @relation("VeterinarianVaccinations")
  reviews            Review[]
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  adminActions       AdminAction[]
  sentMessages       Message[]

  @@map("users")
}

model Role {
  id        String     @id @default(cuid())
  name      String     @unique
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id     String @id @default(cuid())
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Address {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  label     String?
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// ─── Pets ────────────────────────────────────────────────────────────────────

model Pet {
  id           String    @id @default(cuid())
  ownerId      String    @map("owner_id")
  name         String
  species      String
  breed        String?
  gender       String?
  dateOfBirth  DateTime? @map("date_of_birth")
  color        String?
  weight       Float?
  description  String?
  healthStatus String?   @map("health_status")
  profileImage String?   @map("profile_image")
  status       PetStatus @default(ACTIVE)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  owner        User          @relation("PetOwner", fields: [ownerId], references: [id])
  ownerships   PetOwner[]
  listings     PetListing[]
  vaccinations Vaccination[]
  bookings     Booking[]
  images       PetImage[]

  @@map("pets")
}

model PetImage {
  id        String   @id @default(cuid())
  petId     String   @map("pet_id")
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("pet_images")
}

model PetOwner {
  id             String        @id @default(cuid())
  petId          String        @map("pet_id")
  userId         String        @map("user_id")
  ownershipType  OwnershipType @default(PRIMARY) @map("ownership_type")
  startDate      DateTime      @default(now()) @map("start_date")
  endDate        DateTime?     @map("end_date")

  pet  Pet  @relation(fields: [petId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pet_owners")
}

// ─── Auctions ────────────────────────────────────────────────────────────────

model PetListing {
  id            String        @id @default(cuid())
  petId         String        @map("pet_id")
  sellerId      String        @map("seller_id")
  listingType   ListingType   @map("listing_type")
  title         String
  description   String?
  startingPrice Decimal       @map("starting_price") @db.Decimal(12, 2)
  minimumPrice  Decimal?      @map("minimum_price") @db.Decimal(12, 2)
  status        ListingStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  pet     Pet      @relation(fields: [petId], references: [id])
  seller  User     @relation("SellerListings", fields: [sellerId], references: [id])
  auction Auction?
  images  ListingImage[]

  @@map("pet_listings")
}

model ListingImage {
  id        String @id @default(cuid())
  listingId String @map("listing_id")
  imageUrl  String @map("image_url")

  listing PetListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_images")
}

model Auction {
  id               String        @id @default(cuid())
  listingId        String        @unique @map("listing_id")
  startPrice       Decimal       @map("start_price") @db.Decimal(12, 2)
  currentPrice     Decimal       @map("current_price") @db.Decimal(12, 2)
  minimumIncrement Decimal       @map("minimum_increment") @db.Decimal(12, 2)
  reservePrice     Decimal?      @map("reserve_price") @db.Decimal(12, 2)
  startTime        DateTime      @map("start_time")
  endTime          DateTime      @map("end_time")
  status           AuctionStatus @default(SCHEDULED)
  winnerId         String?       @map("winner_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  listing PetListing     @relation(fields: [listingId], references: [id])
  bids    Bid[]
  winner  AuctionWinner?

  @@map("auctions")
}

model Bid {
  id        String    @id @default(cuid())
  auctionId String    @map("auction_id")
  bidderId  String    @map("bidder_id")
  amount    Decimal   @db.Decimal(12, 2)
  bidTime   DateTime  @default(now()) @map("bid_time")
  status    BidStatus @default(VALID)

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  User    @relation(fields: [bidderId], references: [id])

  @@map("bids")
}

model AuctionWinner {
  id               String                  @id @default(cuid())
  auctionId        String                  @unique @map("auction_id")
  winnerId         String                  @map("winner_id")
  winningBidId     String?                 @map("winning_bid_id")
  winningAmount    Decimal                 @map("winning_amount") @db.Decimal(12, 2)
  paymentStatus    PaymentStatus           @default(PENDING) @map("payment_status")
  ownershipStatus  OwnershipTransferStatus @default(PENDING) @map("ownership_status")
  createdAt        DateTime                @default(now()) @map("created_at")

  auction Auction @relation(fields: [auctionId], references: [id])
  winner  User    @relation(fields: [winnerId], references: [id])

  @@map("auction_winners")
}

// ─── Marketplace ─────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  products    Product[]

  @@map("categories")
}

model Product {
  id            String        @id @default(cuid())
  sellerId      String        @map("seller_id")
  categoryId    String        @map("category_id")
  name          String
  description   String?
  price         Decimal       @db.Decimal(12, 2)
  stockQuantity Int           @default(0) @map("stock_quantity")
  sku           String?       @unique
  image         String?
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  seller     User           @relation(fields: [sellerId], references: [id])
  category   Category       @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("products")
}

model ProductImage {
  id        String @id @default(cuid())
  productId String @map("product_id")
  imageUrl  String @map("image_url")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String  @map("cart_id")
  productId String  @map("product_id")
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(12, 2)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id              String        @id @default(cuid())
  buyerId         String        @map("buyer_id")
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  shippingAddress String        @map("shipping_address")
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  orderStatus     OrderStatus   @default(PENDING) @map("order_status")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  buyer User        @relation(fields: [buyerId], references: [id])
  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String  @map("order_id")
  productId  String  @map("product_id")
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ─── Hospitality ─────────────────────────────────────────────────────────────

model ServiceProvider {
  id                 String             @id @default(cuid())
  userId             String             @unique @map("user_id")
  businessName       String             @map("business_name")
  description        String?
  address            String?
  phone              String?
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  rating             Float              @default(0)
  createdAt          DateTime           @default(now()) @map("created_at")

  user         User                    @relation(fields: [userId], references: [id])
  services     Service[]
  availability ProviderAvailability[]

  @@map("service_providers")
}

model Service {
  id          String        @id @default(cuid())
  providerId  String        @map("provider_id")
  serviceType String        @map("service_type")
  name        String
  description String?
  price       Decimal       @db.Decimal(12, 2)
  duration    Int
  capacity    Int           @default(1)
  status      ServiceStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("services")
}

model ProviderAvailability {
  id         String @id @default(cuid())
  providerId String @map("provider_id")
  dayOfWeek  Int    @map("day_of_week")
  startTime  String @map("start_time")
  endTime    String @map("end_time")
  breakStart String? @map("break_start")
  breakEnd   String? @map("break_end")

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_availability")
}

model Booking {
  id            String        @id @default(cuid())
  serviceId     String        @map("service_id")
  petId         String        @map("pet_id")
  customerId    String        @map("customer_id")
  bookingDate   DateTime      @map("booking_date")
  startTime     String        @map("start_time")
  endTime       String        @map("end_time")
  price         Decimal       @db.Decimal(12, 2)
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at")

  service  Service @relation(fields: [serviceId], references: [id])
  pet      Pet     @relation(fields: [petId], references: [id])
  customer User    @relation("CustomerBookings", fields: [customerId], references: [id])

  @@map("bookings")
}

// ─── Vaccination ─────────────────────────────────────────────────────────────

model Vaccination {
  id               String            @id @default(cuid())
  petId            String            @map("pet_id")
  vaccineName      String            @map("vaccine_name")
  doseNumber       Int               @default(1) @map("dose_number")
  administeredDate DateTime          @map("administered_date")
  nextDueDate      DateTime?         @map("next_due_date")
  veterinarianId   String?           @map("veterinarian_id")
  clinicName       String?           @map("clinic_name")
  certificateUrl   String?           @map("certificate_url")
  notes            String?
  status           VaccinationStatus @default(UP_TO_DATE)
  createdAt        DateTime          @default(now()) @map("created_at")

  pet          Pet   @relation(fields: [petId], references: [id], onDelete: Cascade)
  veterinarian User? @relation("VeterinarianVaccinations", fields: [veterinarianId], references: [id])

  @@map("vaccinations")
}

// ─── Notifications & Reviews ─────────────────────────────────────────────────

model Notification {
  id            String           @id @default(cuid())
  userId        String           @map("user_id")
  type          NotificationType
  title         String
  message       String
  referenceType String?          @map("reference_type")
  referenceId   String?          @map("reference_id")
  isRead        Boolean          @default(false) @map("is_read")
  createdAt     DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Review {
  id         String           @id @default(cuid())
  reviewerId String           @map("reviewer_id")
  targetType ReviewTargetType @map("target_type")
  targetId   String           @map("target_id")
  rating     Int
  comment    String?
  createdAt  DateTime         @default(now()) @map("created_at")

  reviewer User @relation(fields: [reviewerId], references: [id])

  @@map("reviews")
}

model AdminAction {
  id          String   @id @default(cuid())
  adminId     String   @map("admin_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminId], references: [id])

  @@map("admin_actions")
}

// ─── Messaging (optional / future) ───────────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  members  ConversationMember[]
  messages Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String @id @default(cuid())
  conversationId String @map("conversation_id")
  userId         String @map("user_id")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  message        String
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@map("messages")
}
